# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Mock Mode (Set to true to run without external API key with realistic telecom responses)
MOCK_LLM=false

# Google Sheets Configuration (Leave empty to use local CSV fallback)
GOOGLE_SHEETS_CREDENTIALS_FILE=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Email SMTP Settings (Leave empty for Dry-Run mode: saves .eml and .html in backend/data/outbox)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=support@orange-telecom-demo.com

# Server Settings
BACKEND_PORT=8000
FRONTEND_PORT=5173
DATABASE_URL=sqlite:///./backend/data/orange_support.db
